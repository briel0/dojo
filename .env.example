# Usuário do GitHub e token com leitura do perfil (as contribuições privadas exigem o token)
GITHUB_LOGIN=
GITHUB_TOKEN=

# Usuário do Codeforces (a API é pública, sem token)
CODEFORCES_HANDLE=

# API do Treinos (na VPS: http://127.0.0.1:5265)
TREINOS_API_URL=

# Aulas dadas: JSON gerado por collector/import_aulas.py (no PC, data/aulas/aulas.json; na VPS,
# /var/lib/dojo/aulas.json)
AULAS_PATH=

# Onde gravar o JSON (no PC, ao lado da página; na VPS, fora do repositório)
OUTPUT_PATH=web/activity.json

# "For you": definições dos treinos (nome e grupos musculares do Treinos), fora do repositório. Sem ele, a
# seção não aparece. Modelo em collector/treinos.example.json (na VPS, /etc/dojo/treinos.json)
TREINOS_PLANO_PATH=

# GRUB (grubufabc.com): id do perfil (o código depois de /users/ na URL). Os ACs entram no quadrinho como
# código e o card do "For you" mostra o problema do dia. A API é pública, sem token.
GRUB_USER_ID=
