# Usuário do GitHub e token com leitura do perfil (as contribuições privadas exigem o token)
GITHUB_LOGIN=
GITHUB_TOKEN=

# Usuário do Codeforces (a API é pública, sem token)
CODEFORCES_HANDLE=

# API do Treinos (na VPS: http://127.0.0.1:5265)
TREINOS_API_URL=

# Aulas dadas: JSON gerado por collector/import_aulas.py (no PC, data/aulas/aulas.json; na VPS,
# /var/lib/dojo/aulas.json)
AULAS_PATH=

# Onde gravar o JSON (no PC, ao lado da página; na VPS, fora do repositório)
OUTPUT_PATH=web/activity.json
